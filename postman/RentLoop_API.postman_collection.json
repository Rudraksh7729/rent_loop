{
  "info": {
    "_postman_id": "7f7a0c4f-7d41-4f17-9e6b-6a7a0f8b2e11",
    "name": "RentLoop API",
    "description": "Proposed REST API specification for the RentLoop college prototype. The current app is frontend-only with React Context and localStorage; this collection documents the future backend contract.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "token",
      "value": "YOUR_JWT_TOKEN"
    },
    {
      "key": "listingId",
      "value": "listing_123"
    },
    {
      "key": "rentalId",
      "value": "rental_123"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo User\",\n  \"email\": \"demo@example.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"renter\",\n  \"location\": \"Chandigarh\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Demo User\",\n  \"location\": \"Chandigarh\",\n  \"preferences\": {\n    \"notifications\": true,\n    \"nearbyAlerts\": true\n  }\n}"
            },
            "url": "{{baseUrl}}/auth/profile"
          }
        }
      ]
    },
    {
      "name": "Listings",
      "item": [
        {
          "name": "List Published Listings",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/listings"
          }
        },
        {
          "name": "Get Listing",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/listings/{{listingId}}"
          }
        },
        {
          "name": "Create Listing",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Sony Camera\",\n  \"description\": \"Mirrorless camera for local rental.\",\n  \"category\": \"Cameras\",\n  \"city\": \"Chandigarh\",\n  \"pricePerDay\": 800,\n  \"images\": [],\n  \"available\": true\n}"
            },
            "url": "{{baseUrl}}/listings"
          }
        },
        {
          "name": "Update Listing",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Sony Camera - Updated\",\n  \"pricePerDay\": 750\n}"
            },
            "url": "{{baseUrl}}/listings/{{listingId}}"
          }
        },
        {
          "name": "Delete Listing",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/listings/{{listingId}}"
          }
        },
        {
          "name": "Publish Listing",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"published\": true\n}"
            },
            "url": "{{baseUrl}}/listings/{{listingId}}/publish"
          }
        },
        {
          "name": "Pause Listing",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paused\": true\n}"
            },
            "url": "{{baseUrl}}/listings/{{listingId}}/pause"
          }
        }
      ]
    },
    {
      "name": "Saved Items",
      "item": [
        {
          "name": "Get Saved Items",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/saved"
          }
        },
        {
          "name": "Save Listing",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/saved/{{listingId}}"
          }
        },
        {
          "name": "Unsave Listing",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/saved/{{listingId}}"
          }
        }
      ]
    },
    {
      "name": "Rentals",
      "item": [
        {
          "name": "Create Rental Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"listingId\": \"{{listingId}}\",\n  \"startDate\": \"2026-10-05\",\n  \"endDate\": \"2026-10-07\"\n}"
            },
            "url": "{{baseUrl}}/rentals"
          }
        },
        {
          "name": "Get My Rentals",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/rentals"
          }
        },
        {
          "name": "Get Rental",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/rentals/{{rentalId}}"
          }
        },
        {
          "name": "Approve Rental",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/rentals/{{rentalId}}/approve"
          }
        },
        {
          "name": "Reject Rental",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Dates are no longer available.\"\n}"
            },
            "url": "{{baseUrl}}/rentals/{{rentalId}}/reject"
          }
        },
        {
          "name": "Cancel Rental",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/rentals/{{rentalId}}/cancel"
          }
        }
      ]
    }
  ]
}